# Data (too large for git). data/samples/ is deliberately NOT ignored —
# it holds the small tracked fixture that lets a fresh clone run Stage 2/3.
data/raw/
data/processed/
data/output/
logs/

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/output/.gitkeep
!logs/.gitkeep

